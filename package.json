{
  "name": "survey-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "dotenv node server/index.js",
    "server": "node server/index.js",
    "build": "tsc && vite build",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "jest --config jest.config.backend.cjs --runInBand --no-cache",
    "test:frontend": "jest --config jest.frontend.config.cjs --no-cache",
    "db:migrate": "knex migrate:latest --knexfile knexfile.cjs",
    "db:seed": "knex seed:run --knexfile knexfile.cjs",
    "seed": "node server/seeds/dev.cjs"
  },
  "dependencies": {
    "@eslint/js": "^9.31.0",
    "argon2": "^0.43.1",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.0",
    "chartjs-node-canvas": "^5.0.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^8.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "lucide-react": "^0.284.0",
    "mongodb": "^6.17.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "node-domexception": "^2.0.2",
    "node-fetch": "^3.3.2",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.1",
    "pptxgenjs": "^4.0.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-cookie-consent": "^9.0.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "react-scripts": "^5.0.1",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.3.0",
    "tmp": "^0.2.3",
    "typescript-eslint": "^8.37.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.3",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.15",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.2.7",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "babel-jest": "^30.0.4",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.5",
    "mongodb-memory-server": "^10.1.4",
    "postcss": "^8.4.27",
    "supertest": "^7.1.3",
    "tailwindcss": "^3.3.3",
    "ts-jest": "^29.4.0",
    "typescript": "^4.9.5",
    "vite": "^4.4.5"
  }
}
